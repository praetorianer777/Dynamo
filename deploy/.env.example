# The suite on a server with Docker Compose (docs/deploying-compose.md).
# compose-secrets.sh copies this file to .env, then gives every secret left
# empty a random value, once. Set the addresses and the mail below, then:
#
#   ./compose-secrets.sh && docker compose up -d
#
# A value set here is never overwritten. Keep .env private: it holds every
# password of the installation.

# What runs besides the three tools. keycloak-server is the bundled Keycloak
# with its own database; leave it out and set OIDC_ISSUER to sign in through
# a Keycloak of one's own. connect connects the three on every start. caddy
# serves the addresses below over HTTPS; leave it out behind a proxy of one's
# own. Add sample-data to import DYNAMO_SAMPLE_SOURCES.
COMPOSE_PROFILES=keycloak-server,connect,caddy
COMPOSE_PROJECT_NAME=dynamo

# The versions Dynamo tested together, as versions.yaml pins them.
STATOR_VERSION=0.2.0
ARMATURE_VERSION=0.2.0
EXCITER_VERSION=0.2.0
STATOR_IMAGES=ghcr.io/praetorianer777/stator
ARMATURE_IMAGES=ghcr.io/cloudster1/armature
EXCITER_IMAGES=ghcr.io/cloudster1/exciter
DYNAMO_CONNECT_IMAGE=ghcr.io/praetorianer777/dynamo-connect:0.1.2

# The addresses people open, each a name of its own that points at this
# machine. With the profile caddy, Caddy gets their certificates.
STATOR_URL=https://stator.example.com
ARMATURE_URL=https://armature.example.com
EXCITER_URL=https://exciter.example.com
KEYCLOAK_URL=https://sso.example.com

# Sign-in. With the bundled Keycloak, compose-secrets.sh sets the first three
# from KEYCLOAK_URL on every run. For a Keycloak of one's own, OIDC_ISSUER is its realm,
# OIDC_BACKCHANNEL stays empty unless the tools reach it at another address
# (public=reachable), and OIDC_HOST is its host name; docs/keycloak.md says
# what the realm must hold.
OIDC_ISSUER=
OIDC_BACKCHANNEL=
OIDC_HOST=
OIDC_GROUPS_CLAIM=groups
STATOR_OIDC_CLIENT_ID=stator
ARMATURE_OIDC_CLIENT_ID=armature
EXCITER_OIDC_CLIENT_ID=exciter
STATOR_OIDC_CLIENT_SECRET=
ARMATURE_OIDC_CLIENT_SECRET=
EXCITER_OIDC_CLIENT_SECRET=
# Whether Stator and Exciter connect each person to their partners when they
# sign in, with the partner apps dynamo-connect registers; false leaves people
# to paste a token on their profile instead.
TOKEN_EXCHANGE=true

# Keycloak's own administrator, at KEYCLOAK_URL/admin. With KEYCLOAK_ADMIN_URL,
# where dynamo-connect reaches that Keycloak, connect keeps the realm's three
# clients at the addresses and client secrets above on every run, leaving
# people's accounts alone; compose-secrets.sh sets it for the bundled one.
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=
KEYCLOAK_ADMIN_URL=
KEYCLOAK_DB_PASSWORD=

# Each tool's local administrator, whom dynamo-connect signs in as, and who
# of the realm is let into all three before their first sign-in, as
# email=admin or email=member, separated by commas.
STATOR_ADMIN_EMAIL=admin@stator.example.com
STATOR_ADMIN_PASSWORD=
ARMATURE_ADMIN_EMAIL=admin@armature.example.com
ARMATURE_ADMIN_PASSWORD=
EXCITER_ADMIN_EMAIL=admin@exciter.example.com
EXCITER_ADMIN_PASSWORD=
DYNAMO_MEMBERS=

# Mail. Stator and Exciter send without a login, so SMTP_ADDR is a relay that
# lets them; only Armature logs in, with SMTP_USER and SMTP_PASSWORD over
# SMTP_TLS (starttls, implicit or none). mailpit:1025 keeps every mail in the
# bundled Mailpit instead of sending it.
SMTP_ADDR=mailpit:1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=starttls
STATOR_MAIL_FROM="Stator <no-reply@example.com>"
ARMATURE_MAIL_FROM="Armature <no-reply@example.com>"
EXCITER_MAIL_FROM="Exciter <no-reply@example.com>"

# Production holds the tools to secure cookies, so the addresses above are
# served over HTTPS, by Caddy or by a proxy of one's own.
DYNAMO_ENV=production
SECURE_COOKIES=true

# The ports on 127.0.0.1 a proxy of one's own sends each address to; Caddy
# reaches the services directly and needs none of them.
KEYCLOAK_PORT=8080
STATOR_WEB_PORT=8081
ARMATURE_WEB_PORT=8082
EXCITER_WEB_PORT=8083
MAILPIT_PORT=8025

# Caddy's ports, open to the internet, and its global options, such as
# "email admin@example.com" for Let's Encrypt's notices.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_GLOBAL_OPTIONS=

# The bundled object store, one bucket per tool.
S3_ACCESS_KEY=dynamo
S3_SECRET_KEY=

# Each tool's databases, Valkey and the key its secrets are sealed with.
STATOR_POSTGRES_PASSWORD=
STATOR_APP_DB_PASSWORD=
STATOR_ADMIN_DB_PASSWORD=
STATOR_VALKEY_PASSWORD=
STATOR_SECRET_KEY=
ARMATURE_POSTGRES_PASSWORD=
ARMATURE_APP_DB_PASSWORD=
ARMATURE_ADMIN_DB_PASSWORD=
ARMATURE_VALKEY_PASSWORD=
ARMATURE_SECRET_KEY=
EXCITER_POSTGRES_PASSWORD=
EXCITER_APP_DB_PASSWORD=
EXCITER_ADMIN_DB_PASSWORD=
EXCITER_VALKEY_PASSWORD=
EXCITER_SECRET_KEY=

# Sample data, with the profile sample-data (README, "Sample data").
# GITHUB_TOKEN raises GitHub's rate limit.
DYNAMO_SAMPLE_SOURCES=sparkplug
DYNAMO_SAMPLE_MAX_ISSUES=500
GITHUB_TOKEN=
